{
  "name": "rodent-vision",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop video inference and review for the Pilot rodent detectors",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  },
  "build": {
    "appId": "hk.rodentvision.desktop",
    "productName": "RodentVision",
    "asar": true,
    "asarUnpack": [
      "backend/**"
    ],
    "files": [
      "dist/**",
      "electron/**",
      "backend/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RodentVision-${version}-portable.${ext}"
    }
  }
}
